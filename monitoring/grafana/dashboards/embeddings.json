{
  "title": "Embeddings",
  "uid": "platform-embeddings",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Vectors encoded (total)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(embed_vectors_total)",
          "legendFormat": "vectors",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Mean encode duration",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(embed_encode_duration_seconds_sum) / sum(embed_encode_duration_seconds_count)",
          "legendFormat": "mean",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mean batch size",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(embed_batch_size_sum) / sum(embed_batch_size_count)",
          "legendFormat": "batch",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Encode duration (p50 / p95 over increase)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (increase(embed_encode_duration_seconds_bucket[1h])))",
          "legendFormat": "index p50",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(embed_encode_duration_seconds_bucket[1h])))",
          "legendFormat": "index p95",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (increase(embed_query_duration_seconds_bucket[1h])))",
          "legendFormat": "query p50",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(embed_query_duration_seconds_bucket[1h])))",
          "legendFormat": "query p95",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Vectors encoded (counter)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "sum(embed_vectors_total)",
          "legendFormat": "vectors",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rerank duration (p50 / p95 over increase)",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (increase(rerank_duration_seconds_bucket[1h])))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(rerank_duration_seconds_bucket[1h])))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      }
    ]
  }
}
