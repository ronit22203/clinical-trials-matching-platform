{
  "title": "OCR",
  "uid": "platform-ocr",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pages processed (total)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(ocr_pages_total)",
          "legendFormat": "pages",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Mean OCR duration",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(ocr_duration_seconds_sum) / sum(ocr_duration_seconds_count)",
          "legendFormat": "mean",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mean confidence",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(ocr_confidence_sum) / sum(ocr_confidence_count)",
          "legendFormat": "confidence",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "OCR errors (total)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(ocr_errors_total) OR on() vector(0)",
          "legendFormat": "errors",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "OCR duration (p50 / p95 over increase)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, backend) (increase(ocr_duration_seconds_bucket[1h])))",
          "legendFormat": "p50 {{backend}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, backend) (increase(ocr_duration_seconds_bucket[1h])))",
          "legendFormat": "p95 {{backend}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pages processed (counter)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "sum by (backend) (ocr_pages_total)",
          "legendFormat": "{{backend}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Confidence (p50 / p95 over increase)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1, "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, backend) (increase(ocr_confidence_bucket[1h])))",
          "legendFormat": "p50 {{backend}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, backend) (increase(ocr_confidence_bucket[1h])))",
          "legendFormat": "p95 {{backend}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "OCR errors (counter)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "expr": "sum by (backend) (ocr_errors_total)",
          "legendFormat": "{{backend}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "${datasource}" }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      }
    ]
  }
}
