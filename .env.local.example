# ── LLM Inference ─────────────────────────────────────────────────────────
# Production (Ubuntu + NVIDIA L4): Ollama — driver-agnostic, GPU auto-detected
# Run: ollama serve &  then  ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Dev (macOS): LM Studio — OpenAI-compatible, JSON mode, no external deps
# LM Studio: install from https://lmstudio.ai, load a GGUF model, enable server (port 1234)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LLM_MODEL=lmstudio-community/Qwen2.5-7B-Instruct-GGUF

# ── Graph Store ────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword

# ── Vector Store ───────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Storage Paths ──────────────────────────────────────────────────────────
DATA_DIR=./data
PDF_INPUT_DIR=./data/pdfs
ARTIFACTS_DIR=./data/artifacts

# ── API Server (agentic-reasoning FastAPI) ─────────────────────────────────
REASONING_API_HOST=0.0.0.0
REASONING_API_PORT=8000

# ── Auth ───────────────────────────────────────────────────────────────────
# Simple username/password auth protecting both API servers.
# Both servers share AUTH_JWT_SECRET so a single login works for both.
#
# Setup (one-time):
#   make auth-setup PASSWORD=admin
# Then paste HASH and SECRET below. Quote the bcrypt hash — $2 is otherwise
# expanded by bash. Do not put inline comments on these two lines.
#
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
AUTH_JWT_SECRET=
AUTH_TOKEN_EXPIRE_MINUTES=480

# ── UI (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=false
